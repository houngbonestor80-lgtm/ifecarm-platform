{
  "name": "ifecarm-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d postgres minio --wait",
    "db:up:postgres": "docker compose up -d postgres --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && npm run db:up && npm run migrate",
    "migrate": "tsx scripts/migrate.ts",
    "codegen": "tsx scripts/codegen.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "argon2": "^0.41.1",
    "kysely": "^0.29.6",
    "next": "^16.3.6",
    "otpauth": "^9.3.4",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^16.4.7",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}

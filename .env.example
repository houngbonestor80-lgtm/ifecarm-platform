# Copier en .env pour le développement local (docker compose up).
# Ne jamais committer .env réel.

# --- Base de données : deux rôles distincts, jamais le même usage. ---
# Valeur : adresse postgres (protocole postgres, rôle, mot de passe du rôle, hôte, port 5432, base ifecarm), à remplir dans le fichier local.
# ifecarm_migrate : migrations uniquement (node-pg-migrate). Propriétaire des
# objets -> le RLS ne s'applique PAS à ce rôle. Ne jamais l'utiliser pour des
# requêtes applicatives.
DATABASE_URL_MIGRATE=

# ifecarm_app : rôle applicatif, seul utilisé par le code Next.js. NOSUPERUSER,
# NOBYPASSRLS (posé dans docker/init-roles.sql) : c'est ce rôle qui rend le
# cloisonnement par entreprise réellement opposable.
DATABASE_URL_APP=

# --- Stockage objet (S3-compatible). Région non arbitrée : ne jamais la
# coder en dur dans le code, uniquement ici. ---
S3_REGION=eu-west-3
S3_BUCKET=ifecarm-platform-dev
S3_ACCESS_KEY_ID=ifecarm_dev
S3_SECRET_ACCESS_KEY=ifecarm_dev_password
# Renseigné uniquement pour MinIO en local ; absent/vide en production (AWS S3
# résout l'endpoint depuis S3_REGION).
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# --- Session ---
# Secret de signature des cookies de session. 32 octets aléatoires en base64 :
# openssl rand -base64 32
SESSION_COOKIE_SECRET=change_me_generate_with_openssl_rand_base64_32

# --- 2FA ---
# Clé de chiffrement au repos des secrets TOTP (AES-256-GCM, 32 octets
# base64) : openssl rand -base64 32. Distincte de SESSION_COOKIE_SECRET —
# une rotation de l'une ne doit jamais invalider l'autre.
TOTP_ENCRYPTION_KEY=change_me_generate_with_openssl_rand_base64_32

# Tests seulement : mot de passe des comptes de test (facultatif ; une valeur fixe de test est utilisée si la variable est absente).
# Jamais un vrai mot de passe.
MOT_DE_PASSE_TEST=

# --- E-mail (relances, alertes, réinitialisation du mot de passe) ---
# Tout fournisseur se branche par SMTP : seule cette configuration change.
# En local, Mailpit (docker compose) reçoit tout sans rien envoyer : http://localhost:8025
# Sans SMTP_HOST, aucun e-mail ne part (les relances restent en file, la
# réinitialisation du mot de passe répond normalement mais n'envoie rien).
# Production — Brevo (relais SMTP) : à mettre dans .env sur le serveur, jamais dans ce fichier.
#   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587   SMTP_SECURE=false
#   SMTP_USER=<identifiant SMTP Brevo (SMTP & API > SMTP)>   SMTP_PASSWORD=<clé SMTP Brevo, pas le mot de passe du compte>
#   SMTP_FROM="IFECARM GROUP <adresse d'un expéditeur/domaine validé dans Brevo>"
#   APP_URL=https://<adresse publique de la plateforme>
# Brevo exige un expéditeur validé ; sans SPF/DKIM du domaine, les messages finissent en indésirables.
SMTP_HOST=localhost
SMTP_PORT=1025
# true = TLS direct (port 465) ; false = STARTTLS si le serveur le propose (587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="IFECARM GROUP <no-reply@ifecarm-qhse.com>"
# Adresse publique de la plateforme, pour les liens des e-mails (sans / final).
APP_URL=http://localhost:3001
